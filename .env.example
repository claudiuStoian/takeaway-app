# Every setting has a development default; nothing here is required to run locally.
# With ENVIRONMENT=production the app refuses to start until the secrets below are changed.

ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=takeaway
DB_USER=takeaway
DB_PASSWORD=takeaway-dev-password

JWT_SECRET_KEY=dev-only-jwt-secret-change-me

# JSON list, e.g. ["http://localhost:5173"]; empty = CORS disabled
CORS_ORIGINS=[]
